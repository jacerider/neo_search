{#
  List Search — the site search results page body.
  - `search_filter` is a views_filter prop: one exposed fulltext filter as data
    plus wiring helpers. It renders as the page's main search input in its own
    GET mini-form: getForm() carries the method/action pair, getHidden() the
    inputs preserving every other query arg, getTextfield() the input attribute
    cluster. There is NO native views exposed form on the page. The placeholder
    is hard-coded because search_api filters never expose one, and
    maxlength="128" mirrors the filter's server-enforced value_maxlength —
    without it an over-long submission silently returns zero rows.
  - The summary line uses summary.total (the view's real match count — exact
    because the bound display uses the full pager) and carries
    data-neo-swap-announce so swapped result updates are announced to screen
    readers.
  - `active_filters` renders the applied search as a removable chip; with only
    one filter bound this mostly mirrors the input, but it keeps working
    unchanged if site builders later add more exposed filters to the view.
  - `items` are a flat relevance-ranked list: a type badge (depluralized for
    the vocabulary labels, which arrive plural), a linked title, and an
    excerpt that prints the highlighter's <strong> marks (views field markup is
    already safe).
  - Empty states differentiate "no query yet" from "no results for X" via
    search_filter.active.
  - data-neo-uuid + data-neo-swap opt into fetch-and-swap (neo_alchemist/swap,
    declared in libraryOverrides): the mini-form submit, chips and pager links
    update the results in place with history support; JS-off falls back to
    normal navigation.
#}
{% set classes = ['list-search', 'bg-default', 'component-bg'] %}
<section {{ attributes.addClass(classes) }} data-neo-uuid="{{ neoUuid }}" data-neo-swap>
  <div class="container-content">

    {% if header %}
      {% block header %}{% endblock %}
    {% endif %}

    {% if label %}
      <h2 class="font-heading text-3xl font-black text-default">{{ label }}</h2>
    {% endif %}

    {% if search_filter %}
      {# Same box recipe as the list_insight search field (border-0/p-0 are
         load-bearing against @tailwindcss/forms base styles; the focus ring
         lives on the form so the whole field lights up), scaled up to page
         prominence. #}
      <form{{ search_filter.getForm() }} class="mt-6 flex h-14 w-full max-w-3xl items-center gap-4 bg-base-100 px-4 focus-within:ring-2 focus-within:ring-primary">
        {{ search_filter.getHidden() }}
        <input{{ search_filter.getTextfield('search').addClass('min-w-0 flex-1 border-0 bg-transparent p-0 text-xl outline-none focus:ring-0 placeholder:text-default/40') }} placeholder="{{ 'Search'|t }}" maxlength="128">
        <button type="submit" class="cursor-pointer text-secondary transition-colors hover:text-primary" aria-label="{{ 'Search'|t }}">{{ icon('search')|icon_class('text-xl') }}</button>
      </form>
    {% endif %}

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
      {% set result_total = summary.total ?? items|length %}
      <span class="text-lg opacity-80" data-neo-swap-announce>
        {% trans %}{{ result_total }} result{% plural result_total %}{{ result_total }} results{% endtrans %}
      </span>
      {% if active_filters.active %}
        <div class="flex flex-wrap items-center gap-3">
          {% for item in active_filters.items %}
            <a{{ active_filters.getLink(item).addClass('group flex items-center gap-2 bg-base-100 px-3 py-1.5 text-sm text-default transition-colors hover:bg-base-200') }}>
              <span>{{ item.label }}</span>
              <span class="text-secondary transition-colors group-hover:text-primary">{{ icon('xmark') }}</span>
            </a>
          {% endfor %}
          {% if active_filters.count > 1 %}
            <a{{ active_filters.getClearLink().addClass('text-sm text-secondary underline transition-colors hover:text-primary') }}>{{ 'Clear all'|t }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if items %}
      <ol class="mt-10 divide-y divide-base-200">
        {% for item in items %}
          <li class="py-6 first:pt-0">
            {# striptags is load-bearing: with twig debug on, views field output
               is wrapped in THEME DEBUG comments, so a bare |trim never
               matches the map (and a comment-only value is truthy). #}
            {% set type_text = item.type|striptags|trim %}
            {% if type_text or item.icon %}
              {# Vocabulary labels arrive plural ("Markets"); the map keeps the
                 badge singular like the content-type labels. #}
              <div class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-secondary">
                {% if item.icon %}{{ icon(item.icon) }}{% endif %}
                {% if type_text %}<span>{{ {'Markets': 'Market'|t, 'Services': 'Service'|t}[type_text]|default(type_text) }}</span>{% endif %}
              </div>
            {% endif %}
            {% set href = item.link.uri ? neo_uri(item.link.uri, item.link.options) : null %}
            {% if item.title %}
              <div class="mt-1 font-heading text-xl font-black">
                {% if href %}<a href="{{ href }}" class="text-default transition-colors hover:text-primary">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
              </div>
            {% endif %}
            {% if item.excerpt %}
              <p class="mt-2 max-w-3xl text-base text-default/70 [&_strong]:font-semibold [&_strong]:text-default">{{ item.excerpt }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    {% elseif search_filter.active ?? false %}
      <p class="mt-10 text-lg text-secondary">{{ 'No results for your search. Try different or more general terms.'|t }}</p>
    {% else %}
      <p class="mt-10 text-lg text-secondary">{{ 'Enter a search term to find content across the site.'|t }}</p>
    {% endif %}

    {# empty:hidden keeps the spacing only when the pager renders. #}
    <div class="mt-10 empty:hidden">{% block footer %}{% endblock %}</div>

  </div>
</section>
