<?php

/**
 * @file
 * Provides configurable quick search bound to text inputs.
 */

use Drupal\Core\Url;

/**
 * Implements hook_page_attachments().
 */
function neo_search_page_attachments(array &$attachments) {
  $route = \Drupal::routeMatch()->getRouteObject();
  if ($route && $route->getOption('_admin_route')) {
    return;
  }

  // The variation list and the user's ability to query it both shape output.
  $attachments['#cache']['contexts'][] = 'user.permissions';
  $attachments['#cache']['tags'][] = 'config:neo_search.settings';
  $attachments['#cache']['tags'][] = 'config:neo_settings_list';
  if (!\Drupal::currentUser()->hasPermission('use neo_search')) {
    return;
  }

  /** @var \Drupal\neo_settings\SettingsRepositoryInterface $repository */
  $repository = \Drupal::service('neo_search.settings');
  $variations = [];
  foreach ($repository->getAll() as $id => $settings) {
    $selectors = array_values(array_filter(array_map('trim', preg_split('/\R+/', (string) $settings->getValue('selectors')))));
    if (!$selectors) {
      continue;
    }
    if ($id !== $settings->getPluginId()) {
      $attachments['#cache']['tags'][] = 'config:neo_settings.variation.' . $id;
    }
    $variations[$id] = [
      'endpoint' => Url::fromRoute('neo_search.query', ['variation' => $id])->toString(),
      'selectors' => $selectors,
      'display' => $settings->getValue('display'),
      'columns' => (int) $settings->getValue('columns'),
      'panelAnchor' => (string) $settings->getValue('panel_anchor'),
      'minChars' => (int) $settings->getValue('min_chars'),
      'maxChars' => (int) $settings->getValue('max_chars'),
      'debounce' => (int) $settings->getValue('debounce'),
      'breakpoint' => (string) $settings->getValue('breakpoint'),
      'texts' => [
        'allResults' => (string) $settings->getValue('all_results_label'),
      ],
    ];
  }

  if ($variations) {
    $attachments['#attached']['library'][] = 'neo_search/search';
    $attachments['#attached']['drupalSettings']['neoSearch']['variations'] = $variations;
  }
}
