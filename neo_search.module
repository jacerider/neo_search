<?php

/**
 * @file
 * Provides configurable quick search bound to text inputs.
 */

use Drupal\neo_search\SearchRunner;
use Drupal\Core\Url;

/**
 * Implements hook_page_attachments().
 */
function neo_search_page_attachments(array &$attachments) {
  $route = \Drupal::routeMatch()->getRouteObject();
  if ($route && $route->getOption('_admin_route')) {
    return;
  }

  // The variation list and the user's ability to query it both shape output.
  $attachments['#cache']['contexts'][] = 'user.permissions';
  $attachments['#cache']['tags'][] = 'config:neo_search.settings';
  $attachments['#cache']['tags'][] = 'config:neo_settings_list';
  if (!\Drupal::currentUser()->hasPermission('use neo_search')) {
    return;
  }

  /** @var \Drupal\neo_settings\SettingsRepositoryInterface $repository */
  $repository = \Drupal::service('neo_search.settings');
  $variations = [];
  foreach ($repository->getAll() as $id => $settings) {
    $selectors = array_values(array_filter(array_map('trim', preg_split('/\R+/', (string) $settings->getValue('selectors')))));
    if (!$selectors) {
      continue;
    }
    if ($id !== $settings->getPluginId()) {
      $attachments['#cache']['tags'][] = 'config:neo_settings.variation.' . $id;
    }
    $variations[$id] = [
      'endpoint' => Url::fromRoute('neo_search.query', ['variation' => $id])->toString(),
      'selectors' => $selectors,
      // Behavior only. Everything that shapes the results markup — columns, the
      // all-results label — is a prop on the server-rendered search_quick
      // component, so it never reaches drupalSettings.
      'display' => $settings->getValue('display'),
      'panelAnchor' => (string) $settings->getValue('panel_anchor'),
      'surround' => (bool) $settings->getValue('surround'),
      'surroundAnchor' => (string) $settings->getValue('surround_anchor'),
      'surroundOverhang' => (int) $settings->getValue('surround_overhang'),
      'minChars' => (int) $settings->getValue('min_chars'),
      'maxChars' => (int) $settings->getValue('max_chars'),
      'debounce' => (int) $settings->getValue('debounce'),
      'breakpoint' => (string) $settings->getValue('breakpoint'),
    ];
  }

  if ($variations) {
    $attachments['#attached']['library'][] = 'neo_search/search';
    $attachments['#attached']['drupalSettings']['neoSearch']['variations'] = $variations;
  }
}

/**
 * Implements hook_themes_installed().
 *
 * Points the panel at the theme's copy of search_quick once there is one.
 * neo_alchemist ejects the component (both modules listen on this hook, and its
 * installer is idempotent, so calling it here removes any dependence on which
 * module's implementation runs first).
 */
function neo_search_themes_installed($theme_list) {
  neo_search_claim_theme_component();
}

/**
 * Repoints the base settings at the front theme's search_quick copy.
 *
 * Only ever upgrades the shipped default. A site builder who has chosen a
 * component — or a saved component — keeps their choice; this is what makes the
 * function safe to call from more than one hook.
 */
function neo_search_claim_theme_component() {
  /** @var \Drupal\neo_alchemist\ThemeComponentInstaller $installer */
  $installer = \Drupal::service('neo_alchemist.theme_component_installer');
  $installer->installAll();
  $theme = $installer->resolveTheme();
  if (!$theme) {
    return;
  }
  $config = \Drupal::configFactory()->getEditable('neo_search.settings');
  if ($config->get('component') !== SearchRunner::DEFAULT_COMPONENT) {
    return;
  }
  $id = $theme . ':search_quick';
  if (\Drupal::service('plugin.manager.sdc')->hasDefinition($id)) {
    $config->set('component', $id)->save();
  }
}
